{
  "name": "@mestechko/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mestechko/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "openapi": "node --conditions=@mestechko/source --import tsx scripts/generate-openapi.ts",
    "openapi:check": "node --conditions=@mestechko/source --import tsx scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@mestechko/domain": "workspace:*",
    "libphonenumber-js": "1.13.14",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
