{
  "name": "@slotwise/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "@slotwise/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@slotwise/source": "./src/client-entry.ts",
      "types": "./dist/client-entry.d.ts",
      "default": "./dist/client-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate": "node --conditions=@slotwise/source --import tsx scripts/generate-artifacts.ts",
    "generate:check": "node --conditions=@slotwise/source --import tsx scripts/generate-artifacts.ts --check"
  },
  "dependencies": {
    "@slotwise/domain": "workspace:*",
    "libphonenumber-js": "1.13.14",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
