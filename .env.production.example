# Продакшен Slotwise: скопируйте в .env.production рядом с docker-compose.prod.yml,
# заполните и закройте доступ: chmod 600 .env.production. Файл не коммитится.
# Пошагово: docs/deploy.md. Секреты — случайные hex-строки: openssl rand -hex 32.

# --- Публичные имена (DNS A/AAAA → IP сервера) ---------------------------------
SITE_DOMAIN=slotwise.example
CABINET_DOMAIN=app.slotwise.example
MINIAPP_DOMAIN=miniapp.slotwise.example
WIDGET_DOMAIN=widget.slotwise.example
API_DOMAIN=api.slotwise.example
# Почта для Let's Encrypt (уведомления о сертификатах)
ACME_EMAIL=
# Только для пробного запуска на своей машине: порты и адрес публикации.
# В продакшене оставьте как есть (80/443 на всех адресах, без суффикса).
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT_SUFFIX=

# --- Одно имя с путями (вместо пяти имён) ------------------------------------------
# Все части на одном имени, например https://slotwise.example/app: задайте адреса частей, тогда
# имена выше не используются. Приложения собираются под путь своего адреса. Пути раздаёт
# прокси перед стеком; встроенный edge этого файла знает только отдельные имена.
SITE_PUBLIC_URL=
CABINET_PUBLIC_URL=
MINIAPP_PUBLIC_URL=
WIDGET_PUBLIC_URL=
API_PUBLIC_URL=
# Страница тестовой кассы под путём API (например /api/test-pay) и путь cookie сессии
# кабинета — только запросы к API (например /api). По умолчанию /test-pay и /.
TEST_PAY_CHECKOUT_BASE_URL=
SESSION_COOKIE_PATH=

# --- База данных и Redis (openssl rand -hex 24) ----------------------------------
# Владелец базы: миграции, сиды, бэкапы
POSTGRES_PASSWORD=
# Роль приложения slotwise_app (без обхода RLS)
APP_DB_PASSWORD=
REDIS_PASSWORD=
# Номер базы Redis: 0 на своём сервере; на Redis, общем с другими продуктами, — свой номер.
REDIS_DB=0
DATABASE_POOL_MAX=10

# --- Telegram ----------------------------------------------------------------------
# Токен от @BotFather и имя бота без @, например <имя_бота>_bot. Пустое имя — на сайте и в
# приложениях нет ссылок на бота
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет заголовка вебхука: 32+ символа [A-Za-z0-9_-] (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# --- MAX ---------------------------------------------------------------------------
# Настоящий бот MAX: токен и https://platform-api2.max.ru.
# Демо с эмулятором: любой токен от 16 символов, MAX_API_BASE_URL=http://api:46210/max-emulator,
# MAX_EMULATOR_ENABLED=true (только вместе с DEMO_MODE=true).
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_EMULATOR_ENABLED=false

# --- Платежи -------------------------------------------------------------------------
PAYMENTS_PROVIDER=test
TEST_PAY_SECRET_KEY=
TEST_PAY_WEBHOOK_SECRET=
# true — встроенный эмулятор тестовой кассы (только вместе с DEMO_MODE=true)
TEST_PAY_EMULATOR_ENABLED=false
# embedded — страница кассы вместо приложения, external — во внешнем окне
TEST_PAY_CHECKOUT=embedded

# --- Виджет --------------------------------------------------------------------------
WIDGET_SIGNING_KEY=

# --- Демо ------------------------------------------------------------------------------
# true — демо-вход в кабинет, эмулятор запуска Mini App, пометка «Демо-версия».
# Для демо также запускайте профиль demo: ночной сброс демо-данных.
DEMO_MODE=false
TELEGRAM_DEMO_SIGNING_KEY=
DEMO_RESET_CRON=0 4 * * *
DEMO_RESET_TIMEZONE=Europe/Moscow

# --- Бэкапы PostgreSQL ------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_TIME=03:30
BACKUP_TZ=Europe/Moscow
BACKUP_KEEP_DAYS=14

# --- Процессы ------------------------------------------------------------------------
# Роли процесса api. На маленьком сервере — api,worker,bot в одном процессе, сервисы worker
# и bot тогда не запускаются (docs/deploy.md, «Один процесс»).
API_ROLES=api

# --- Наблюдаемость -------------------------------------------------------------------
LOG_LEVEL=info
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Образы ----------------------------------------------------------------------------
IMAGE_TAG=latest
