{
  "name": "slotwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.11.1",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "env:init": "node tooling/env/init-env.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:stop": "docker compose stop",
    "db:provision": "pnpm --filter @slotwise/api db:provision",
    "db:migrate": "pnpm --filter @slotwise/api db:migrate",
    "db:codegen": "pnpm --filter @slotwise/api db:codegen",
    "db:seed": "pnpm --filter @slotwise/api db:seed",
    "db:setup": "pnpm db:provision && pnpm db:migrate && pnpm db:seed",
    "demo:reset": "pnpm --filter @slotwise/api db:seed",
    "demo:schedule": "pnpm --filter @slotwise/api demo:schedule",
    "bot:setup": "pnpm --filter @slotwise/api bot:setup",
    "bot:check": "pnpm --filter @slotwise/api bot:check",
    "dev:api": "pnpm --filter @slotwise/api dev",
    "dev:miniapp": "pnpm --filter @slotwise/miniapp dev",
    "dev:cabinet": "pnpm --filter @slotwise/cabinet dev",
    "dev:widget": "pnpm --filter @slotwise/widget dev",
    "dev:landing": "pnpm --filter @slotwise/landing dev",
    "stand": "node tooling/stand/stand.ts start",
    "stand:status": "node tooling/stand/stand.ts status",
    "stand:stop": "node tooling/stand/stand.ts stop",
    "build": "pnpm -r --workspace-concurrency=2 build",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:integration": "pnpm --filter @slotwise/api test:integration",
    "contracts:check": "pnpm --filter @slotwise/contracts generate:check",
    "gate:limits": "node tooling/gates/source-limits.ts",
    "gate:tokens": "node tooling/gates/design-tokens.ts",
    "gate:locales": "node tooling/gates/locales.ts",
    "gate": "pnpm gate:limits && pnpm gate:tokens && pnpm gate:locales && pnpm format:check && pnpm lint && pnpm typecheck && pnpm contracts:check && pnpm test",
    "screenshots": "node --env-file-if-exists=.env tooling/screenshots/run.ts",
    "media:landing": "node --env-file-if-exists=.env tooling/media/run.ts landing",
    "media:film": "node --env-file-if-exists=.env tooling/media/run.ts film",
    "brand:assets": "node tooling/brand/assets.ts",
    "contracts:generate": "pnpm --filter @slotwise/contracts generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
