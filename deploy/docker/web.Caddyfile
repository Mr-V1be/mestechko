# Static files of one web app. TLS, compression for clients and security headers
# are the edge proxy's job; this server only answers inside the network.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv

	# Hashed bundles never change under the same name.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Screens and loops of the product site change with a release, rarely.
	@media path /media/*
	header @media Cache-Control "public, max-age=86400"
	# Everything else (pages, widget.js) is revalidated, so a release shows at once.
	@fresh not path /assets/* /media/*
	header @fresh Cache-Control "no-cache"

	handle /healthz {
		respond 200
	}
	# A missing bundle is a 404, never the app's page served as JavaScript.
	handle /assets/* {
		file_server
	}
	# Client-side routes of the single-page apps fall back to the app's page.
	handle {
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
