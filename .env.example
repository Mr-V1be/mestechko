# Окружение «Местечко». Скопируйте в .env командой `pnpm env:init`:
# она подставит локальные адреса и сгенерирует случайные секреты.
# Значения секретов не коммитятся и не печатаются в логах.

# --- Процесс API ---------------------------------------------------------------
# development | test | production
NODE_ENV=
# Роли процесса через запятую: api (HTTP), worker (очереди BullMQ), bot (long polling ботов)
APP_ROLES=
# Адрес и порт HTTP API (диапазон проекта 46200–46299, по умолчанию 46210)
API_HOST=
API_PORT=
# Разрешённые источники браузерных запросов через запятую (пусто — только same-origin)
CORS_ORIGINS=
# Уровень логов: fatal, error, warn, info, debug, trace
LOG_LEVEL=

# --- PostgreSQL ------------------------------------------------------------------
# Пароль суперпользователя mestechko (docker compose, миграции, сиды)
POSTGRES_PASSWORD=
# Строка подключения администратора: миграции и сиды
DATABASE_ADMIN_URL=
# Строка подключения приложения: роль mestechko_app без обхода RLS
DATABASE_URL=
# Размер пула соединений приложения
DATABASE_POOL_MAX=

# --- Redis -------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=

# --- Telegram ----------------------------------------------------------------------
# Токен бота от @BotFather. Выдаёт владелец; без него Mini App работает в демо-режиме.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — для ссылки «включить напоминания» в Mini App
TELEGRAM_BOT_USERNAME=
# Адрес Bot API (по умолчанию https://api.telegram.org; свой сервер Bot API — тоже сюда)
TELEGRAM_API_ROOT=
# Как бот получает обновления: polling (процесс с ролью bot) или webhook (продакшен)
TELEGRAM_UPDATES_MODE=
# Для webhook: публичный https-адрес /v1/telegram/webhook и секрет заголовка (32+ символа)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Сколько секунд принимаются данные запуска Mini App (по умолчанию сутки)
TELEGRAM_INIT_DATA_TTL_SECONDS=
# Публичный https-адрес Mini App. Пока пусто — кнопок «Открыть» и menu button у бота нет
MINIAPP_PUBLIC_URL=

# --- MAX -------------------------------------------------------------------------------
# Токен бота MAX. В демо бот работает с эмулятором MAX Bot API, встроенным в API
MAX_BOT_TOKEN=
# Адрес MAX Bot API: https://platform-api2.max.ru или эмулятор http://127.0.0.1:46210/max-emulator
MAX_API_BASE_URL=
# true — включить эмулятор MAX (только при DEMO_MODE=true) и экран «Эмулятор MAX» в кабинете
MAX_EMULATOR_ENABLED=

# --- Платежи (предоплата) ------------------------------------------------------------
# Провайдер предоплат: test — тестовый провайдер (в демо его эмулятор встроен в API)
PAYMENTS_PROVIDER=
# Адрес API тестового провайдера: эмулятор http://127.0.0.1:46210/test-pay/api
TEST_PAY_API_URL=
# Секретный ключ магазина у тестового провайдера (генерируется `pnpm env:init`)
TEST_PAY_SECRET_KEY=
# Секрет подписи уведомлений (вебхуков) провайдера (генерируется `pnpm env:init`)
TEST_PAY_WEBHOOK_SECRET=
# true — включить эмулятор тестового провайдера: API, страница оплаты, вебхуки (только DEMO_MODE=true)
TEST_PAY_EMULATOR_ENABLED=
# Куда эмулятор отправляет вебхуки: http://127.0.0.1:46210/v1/payments/webhooks/test
TEST_PAY_WEBHOOK_URL=
# Публичный адрес страницы оплаты эмулятора; путь /test-pay — тот же сайт, что и Mini App
TEST_PAY_CHECKOUT_BASE_URL=
# Где открывается страница тестовой кассы: embedded — вместо приложения, external — в браузере
TEST_PAY_CHECKOUT=
# Страница «Оплата завершена» для оплаты во внешнем окне (абсолютный адрес): https://…/v1/payments/return
PAYMENTS_RETURN_PAGE_URL=

# --- Виджет для сайта ----------------------------------------------------------------
# Ключ подписи ссылок, по которым посетитель сайта видит свою запись (генерируется `pnpm env:init`)
WIDGET_SIGNING_KEY=

# --- Демо --------------------------------------------------------------------------
# true — включает демо-вход в кабинет и эмулятор запуска Mini App вне Telegram
DEMO_MODE=
# Ключ подписи демо-данных запуска Mini App (генерируется `pnpm env:init`)
TELEGRAM_DEMO_SIGNING_KEY=

# --- Сессии кабинета ---------------------------------------------------------------
SESSION_TTL_DAYS=
# true — cookie только по HTTPS (в production включено всегда)
COOKIE_SECURE=

# --- Внешние провайдеры --------------------------------------------------------------
# Производственный календарь isdayoff.ru (бесплатный API)
ISDAYOFF_BASE_URL=
# Таймаут внешних HTTP-запросов, мс
EXTERNAL_HTTP_TIMEOUT_MS=

# --- Наблюдаемость -------------------------------------------------------------------
# true — метрики Prometheus на /metrics
METRICS_ENABLED=
# OTLP/HTTP-коллектор трасс, например http://127.0.0.1:4318 (пусто — трассы не выгружаются)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# --- Фронтенды (подставляются при сборке Vite) ---------------------------------------
# Префикс API для браузера; в разработке Vite проксирует /api на API_PORT
VITE_API_BASE_URL=
# true — показывать пометку «Демо-версия» и демо-вход
VITE_DEMO_MODE=
# Адрес виджета записи для сайтов (скрипт widget.js и форма); код для вставки в кабинете
VITE_WIDGET_BASE_URL=
# Адреса частей продукта для переходов между ними в демо: сайт, кабинет, Mini App, бот
VITE_LANDING_URL=
VITE_CABINET_URL=
VITE_MINIAPP_URL=
VITE_BOT_URL=
