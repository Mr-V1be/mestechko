{
  "name": "@mestechko/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@mestechko/source src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:provision": "node --env-file-if-exists=../../.env --conditions=@mestechko/source --import tsx src/cli/provision-database.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --conditions=@mestechko/source --import tsx src/cli/migrate.ts",
    "db:codegen": "node --env-file-if-exists=../../.env --conditions=@mestechko/source --import tsx src/cli/codegen.ts",
    "db:seed": "node --env-file-if-exists=../../.env --conditions=@mestechko/source --import tsx src/cli/seed.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "bot:setup": "node --env-file-if-exists=../../.env --conditions=@mestechko/source --import tsx src/cli/setup-telegram-bot.ts",
    "bot:check": "node --env-file-if-exists=../../.env --conditions=@mestechko/source --import tsx src/cli/bot-check.ts",
    "db:recreate": "node --env-file-if-exists=../../.env --conditions=@mestechko/source --import tsx src/cli/recreate-database.ts"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@mestechko/contracts": "workspace:*",
    "@mestechko/domain": "workspace:*",
    "@mestechko/i18n": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-prometheus": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@tma.js/init-data-node": "2.0.8",
    "bullmq": "6.3.11",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "fastify": "5.12.5",
    "grammy": "1.46.0",
    "import-in-the-middle": "3.5.2",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "nestjs-pino": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "11.2.1",
    "read-excel-file": "9.3.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "write-excel-file": "4.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
